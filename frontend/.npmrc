# jsroot pulls Node-only native deps (canvas → node-gyp+cairo, resvg, jsdom) that it
# only uses server-side. We never touch them in the browser (and alias them to a stub
# in vite.config.js), so skip dependency install scripts to avoid native builds in the
# slim frontend image. `npm run build` still runs (ignore-scripts only blocks lifecycle
# + pre/post scripts, not explicit run-scripts).
ignore-scripts=true
